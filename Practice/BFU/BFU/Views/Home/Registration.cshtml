
@{
    ViewBag.Title = "Registration";
}



<h2>Registration</h2>

<form action="" method="post">
    Name:
    <input type="text" value="@Model.Name" name="Name" placeholder="Enter your name" />
    <span>@Html.ValidationMessage("Name")</span>
    <br />
    Email:
    <input type="text" value="@Model.Email" name="Email" placeholder="Enter your email" />
    <span>@Html.ValidationMessage("Email")</span>
    <br />
    Phone Number:
    <input type="text" name="PhoneNumber" value="@Model.PhoneNumber" placeholder="Enter the Phone Number" />
    <span>@Html.ValidationMessage("PhoneNumber")</span>
    <br />
    Department:
    <select id="Type" name="DeparmentID">
        <option value="" disabled selected>Select the Department</option>
        @foreach(var dept in ViewBag.Departments)
            {
                <option value="@dept.ID">@dept.Name</option>
            }
    </select>
    <br />

    <input type="submit" name="Submit" />
</form>